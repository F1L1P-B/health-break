<Window
    x:Class="HealthBreak.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="#0B1015" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#10171E" BorderBrush="#202B35" BorderThickness="0,0,1,0">
            <Grid Padding="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,0,0,30">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" Background="{StaticResource Accent}" CornerRadius="10">
                            <FontIcon Glyph="&#xE95E;" Foreground="#10211B" FontSize="17"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="HealthBreak" FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="A healthier work rhythm" Margin="44,4,0,0"
                               Foreground="{StaticResource Muted}" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="7">
                    <TextBlock Text="YOUR SPACE" Margin="12,0,0,8" Foreground="#667582"
                               FontSize="10" CharacterSpacing="150" />
                    <Button x:Name="DashboardNav" Tag="Dashboard" Click="Navigate_Click"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock Text="Overview" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatisticsNav" Tag="Statistics" Click="Navigate_Click"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                            <TextBlock Text="Statistics" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExercisesNav" Tag="Exercises" Click="Navigate_Click"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <FontIcon Glyph="&#xEADA;" FontSize="16" />
                            <TextBlock Text="Exercise library" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Tag="Settings" Click="Navigate_Click"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HelpNav" Tag="Help" Click="Navigate_Click"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <FontIcon Glyph="&#xE897;" FontSize="16" />
                            <TextBlock Text="Help" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="10">
                    <Border Background="#17221D" BorderBrush="#294337" BorderThickness="1"
                            CornerRadius="14" Padding="14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MonitoringStatus}" FontSize="12"
                                           Foreground="#B9EDCA" />
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentAppText}" FontSize="10"
                                       Foreground="#7F9088" TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                    </Border>
                    <Button Content="Start a break" Click="StartBreak_Click"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Content="Exit HealthBreak" Click="Exit_Click"
                            Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Padding="34,26,34,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding PageEyebrow}" Foreground="{StaticResource Accent}"
                               FontSize="10" CharacterSpacing="160" />
                    <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                    <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource Muted}"
                               FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="{Binding PauseButtonText}" Click="Pause_Click"
                        Style="{StaticResource QuietButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" MinWidth="96" />
            </Grid>

            <Border x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed"
                    Background="#3A2022" BorderBrush="#784047" BorderThickness="1"
                    CornerRadius="12" Padding="14" Margin="0,18,0,0">
                <TextBlock x:Name="ErrorMessage" Foreground="#F7C8CC" TextWrapping="Wrap" />
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,24,0,0"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="DashboardPage" Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#17251F" BorderBrush="#2C493B"
                                    BorderThickness="1" CornerRadius="22" Padding="28">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="CURRENT SESSION" Foreground="{StaticResource Accent}"
                                                       FontSize="10" CharacterSpacing="160" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding NextBreakText}" Foreground="#91A39A"
                                                   FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding SessionTime}" FontSize="62"
                                               FontWeight="Light" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="2" Text="{Binding SessionMessage}" FontSize="14"
                                               Foreground="#B9C5BE" TextWrapping="Wrap"
                                               Margin="0,0,0,18" />
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Value="{Binding SessionProgress}" Maximum="100"
                                                     Height="5" Foreground="{StaticResource Accent}"
                                                     Background="#294036" VerticalAlignment="Center"
                                                     Margin="0,0,18,0" />
                                        <Button Grid.Column="1" Content="Take a break"
                                                Click="StartBreak_Click"
                                                Style="{StaticResource PrimaryButton}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="HEALTH SCORE" Foreground="{StaticResource Muted}"
                                                   FontSize="10" CharacterSpacing="150" />
                                        <TextBlock Text="{Binding ScoreStatus}" Foreground="{Binding ScoreBrush}"
                                                   FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Margin="0,16">
                                        <TextBlock Text="{Binding Score}" Foreground="{Binding ScoreBrush}"
                                                   FontSize="66" FontWeight="Light"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="/ 100" Foreground="#66747F" FontSize="12"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding ScoreMessage}"
                                               Foreground="#9CAAA2" FontSize="12"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="ACTIVE TODAY" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding ActiveToday}" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Text="Focused input time" Style="{StaticResource Caption}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="SINCE LAST BREAK" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding SinceBreakText}" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Continuous active time" Style="{StaticResource Caption}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="BREAKS TODAY" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding BreaksToday}" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Text="Completed pauses" Style="{StaticResource Caption}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="LONGEST SESSION" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding LongestSession}" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Text="Today" Style="{StaticResource Caption}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="AVERAGE SESSION" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding AverageSessionText}" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="SKIPPED BREAKS" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding SkippedText}" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="EXERCISES DONE" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding ExercisesCompleted}" FontSize="25" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource Card}" Padding="19">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="STATUS" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Text="{Binding MonitoringStatus}" Foreground="{StaticResource Accent}"
                                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Padding="22">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" Background="#22372D" CornerRadius="15">
                                    <FontIcon Glyph="&#xE95E;" Foreground="{StaticResource Accent}"
                                              FontSize="21" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding SuggestedExerciseMeta}"
                                               Foreground="{StaticResource Accent}" FontSize="10"
                                               CharacterSpacing="100" />
                                    <TextBlock Text="{Binding SuggestedExerciseName}" FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SuggestedExerciseDescription}"
                                               Foreground="{StaticResource Muted}" FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Start with this exercise"
                                        Click="StartBreak_Click" Style="{StaticResource QuietButton}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="StatisticsPage" Visibility="Collapsed" Spacing="16">
                        <Border Background="#17251F" BorderBrush="#2C493B"
                                BorderThickness="1" CornerRadius="20" Padding="24">
                            <StackPanel Spacing="7">
                                <TextBlock Text="THIS WEEK" Foreground="{StaticResource Accent}"
                                           FontSize="10" CharacterSpacing="150" />
                                <TextBlock Text="{Binding StatisticsSummary}" FontSize="18"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="18">
                                <TextBlock Text="Active time · last 7 days" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding WeekColumns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="112" Height="158" Margin="4,0">
                                                <StackPanel VerticalAlignment="Bottom" Spacing="6">
                                                    <TextBlock Text="{Binding ValueLabel}" FontSize="10"
                                                               Foreground="#93A299" HorizontalAlignment="Center" />
                                                    <Border Height="{Binding Height}" MinHeight="3"
                                                            Background="{Binding Brush}" CornerRadius="6,6,2,2" />
                                                    <TextBlock Text="{Binding Day}" FontSize="11"
                                                               Foreground="{StaticResource Muted}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Reminder habits" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ReminderHabits}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Application categories" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ApplicationSummary}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Daily details" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding WeekRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#25313C" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Day}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Active}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Idle}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Sessions}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Breaks}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Exercises}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ExercisesPage" Visibility="Collapsed" Spacing="16">
                        <Border Background="#17251F" BorderBrush="#2C493B"
                                BorderThickness="1" CornerRadius="20" Padding="24">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="A SMALL RESET CAN CHANGE THE REST OF YOUR DAY"
                                               Foreground="{StaticResource Accent}" FontSize="10"
                                               CharacterSpacing="130" />
                                    <TextBlock Text="Gentle ideas for eyes, neck, shoulders, back and movement."
                                               FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Exercises are selected locally using simple, transparent rules."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Start a guided break"
                                        Click="StartBreak_Click" Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Library}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="13" Background="#22372D">
                                                <FontIcon Glyph="&#xE95E;" Foreground="{StaticResource Accent}"
                                                          FontSize="17" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource Accent}"
                                                           FontSize="10" CharacterSpacing="100" />
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationLabel}"
                                                       Foreground="#AAB7B0" FontSize="12"
                                                       TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="HelpPage" Visibility="Collapsed" Spacing="16">
                        <Border Background="#17251F" BorderBrush="#2C493B"
                                BorderThickness="1" CornerRadius="20" Padding="24">
                            <StackPanel Spacing="8">
                                <TextBlock Text="HEALTHBREAK QUICK GUIDE" Foreground="{StaticResource Accent}"
                                           FontSize="10" CharacterSpacing="150" />
                                <TextBlock Text="Build a rhythm that includes real recovery."
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="HealthBreak observes only the time of the latest mouse or keyboard activity. It never stores pressed keys, typed text, window titles or screen content."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="1 · Activity and idle" Foreground="{StaticResource Accent}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="The current session grows while input is active. When idle reaches the configured threshold, that quiet period is removed from active work. Natural breaks are recognized when you return."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="2 · Reminders" Foreground="{StaticResource Accent}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Reminders become stronger at your four configured thresholds. Start a break, postpone it for five minutes, or skip it. Each threshold is shown once unless you explicitly snooze."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="3 · Guided breaks" Foreground="{StaticResource Accent}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Quick is suggested first, Short from the second reminder, and Full at the strong reminder. Completing any guided break resets the continuous-session timer to zero. Exercise completion is always confirmed manually."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="4 · Health Score" Foreground="{StaticResource Accent}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="The score is a motivational habit indicator. Long sessions, skips and snoozes lower it with capped penalties. Completed breaks and exercises raise it again, so a poor result is recoverable during the same day."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="5 · Tray and Demo Mode" Foreground="{StaticResource Accent}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Closing the main window keeps HealthBreak in the system tray. Use its menu to open, pause, start a break or exit. Demo Mode speeds time up 60× and is clearly marked."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="6 · Local data safety" Foreground="{StaticResource Accent}"
                                               FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="SQLite writes use transactions and durability checks. HealthBreak keeps a rolling local backup. If corruption is detected at startup, it restores the backup or safely starts a new database while preserving the damaged file for recovery."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#2C2619" BorderBrush="#574929"
                                BorderThickness="1" CornerRadius="16" Padding="18">
                            <TextBlock Text="HealthBreak is not a medical device or medical advice. Move gently and stop any exercise that causes pain."
                                       Foreground="#E8D4A8" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <ContentControl x:Name="SettingsHost" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
