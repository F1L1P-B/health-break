<UserControl x:Class="HealthBreak.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="18" Padding="0,0,8,18">
   <Border Background="#151D25" BorderBrush="#25313C" BorderThickness="1" CornerRadius="20" Padding="24">
    <StackPanel Spacing="16">
     <TextBlock Text="Find your reminder rhythm" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Reminders follow continuous active time. Enter increasing values in minutes." Foreground="#8E9CA9" FontSize="13" TextWrapping="Wrap"/>
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <NumberBox x:Name="First" Header="Gentle reminder" />
      <NumberBox x:Name="Second" Grid.Column="1" Header="Clear reminder" />
      <NumberBox x:Name="Recommended" Grid.Column="2" Header="Recommended break" />
      <NumberBox x:Name="Strong" Grid.Column="3" Header="Strong / strict limit" />
     </Grid>
    </StackPanel>
   </Border>

   <Border Background="#151D25" BorderBrush="#25313C" BorderThickness="1" CornerRadius="20" Padding="24">
    <StackPanel Spacing="16">
     <TextBlock Text="Activity &amp; natural breaks" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Idle time is removed from active time once the threshold is reached. A full natural break resets the continuous session." Foreground="#8E9CA9" FontSize="13" TextWrapping="Wrap"/>
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <NumberBox x:Name="Idle" Header="Idle threshold · seconds" />
      <NumberBox x:Name="MinimumBreak" Grid.Column="1" Header="Minimum natural break · seconds" />
      <NumberBox x:Name="FullBreak" Grid.Column="2" Header="Full break above · seconds" />
     </Grid>
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ToggleSwitch x:Name="ResetShort" Header="Short natural break resets the session" />
      <NumberBox x:Name="Credit" Grid.Column="1" Header="Short break credit · minutes" />
     </Grid>
    </StackPanel>
   </Border>

   <Border Background="#151D25" BorderBrush="#25313C" BorderThickness="1" CornerRadius="20" Padding="24">
    <StackPanel Spacing="16">
     <TextBlock Text="Quietly working for you" FontSize="20" FontWeight="SemiBold"/>
     <Grid ColumnSpacing="24" RowSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ToggleSwitch x:Name="Notifications" Header="Break notifications" />
      <ToggleSwitch x:Name="Sound" Grid.Column="1" Header="Notification sound" />
      <ToggleSwitch x:Name="Startup" Grid.Row="1" Header="Start with Windows" />
      <ToggleSwitch x:Name="Tracking" Grid.Row="1" Grid.Column="1" Header="Application categories" />
      <ToggleSwitch x:Name="Strict" Grid.Row="2" Header="Strict mode" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="Strict mode keeps Emergency skip available. Windows shortcuts, Task Manager and closing the app remain available." Foreground="#8E9CA9" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel>
   </Border>

   <Border Background="#302818" BorderBrush="#5A4828" BorderThickness="1" CornerRadius="20" Padding="24">
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="8"><TextBlock Text="Demo mode · built for the big moment" FontSize="19" FontWeight="SemiBold" Foreground="#EFD19B"/><TextBlock Text="60× time: a 30-minute reminder arrives after 30 real seconds of activity. History is kept separate, and demo mode turns off when you restart." Foreground="#C4B99D" FontSize="13" TextWrapping="Wrap"/></StackPanel>
     <ToggleSwitch x:Name="Demo" Grid.Column="1" Header="DEMO 60×" VerticalAlignment="Center"/>
    </Grid>
   </Border>

   <InfoBar x:Name="SaveMessage" IsOpen="False" />
   <Grid Margin="0,0,0,16">
    <TextBlock Text="Changes apply when you save." Foreground="#8E9CA9" FontSize="13" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
     <Button Content="Restore defaults" Click="Defaults_Click"/>
     <Button x:Name="SaveButton" Content="Save preferences" Click="Save_Click"/>
    </StackPanel>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
