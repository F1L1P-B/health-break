<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Accent" Color="#B9EDCA" />
 <SolidColorBrush x:Key="Muted" Color="#8E9CA9" />
 <SolidColorBrush x:Key="CardBackground" Color="#151D25" />
 <SolidColorBrush x:Key="CardBorder" Color="#25313C" />
 <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EEF4F6" />
 <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#B9EDCA" />
 <Style x:Key="Card" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource CardBackground}" />
  <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
  <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="20" /><Setter Property="Padding" Value="24" />
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="13" /></Style>
 <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
 <Style x:Key="PrimaryButton" TargetType="Button">
  <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#10211B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22,13"/><Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="QuietButton" TargetType="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,11"/><Setter Property="Background" Value="#1D2832"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,14"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
</ResourceDictionary>
